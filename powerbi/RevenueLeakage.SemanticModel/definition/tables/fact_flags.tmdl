table fact_flags

	measure 'Total Leakage' = CALCULATE(SUM(fact_flags[impact_usd]), fact_flags[direction] = "Under-billed", fact_flags[is_visible] = TRUE(), KEEPFILTERS(fact_flags[status] <> "False alarm"))
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'Confirmed Leakage' = CALCULATE([Total Leakage], fact_flags[status] = "Confirmed")
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'Unreviewed Leakage' = CALCULATE([Total Leakage], fact_flags[status] = "Unreviewed")
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'Needs Info Leakage' = CALCULATE([Total Leakage], fact_flags[status] = "Needs info")
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'Total Revenue' = SUM(fact_invoice_lines[net_amount])
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'Leakage % of Revenue' = DIVIDE([Total Leakage], [Total Revenue])
		formatString: 0.00%
		displayFolder: 1 Leakage

	measure 'Leakage Flags' = CALCULATE(COUNTROWS(fact_flags), fact_flags[direction] = "Under-billed", fact_flags[is_visible] = TRUE(), KEEPFILTERS(fact_flags[status] <> "False alarm"))
		formatString: #,0
		displayFolder: 1 Leakage

	measure 'Hidden Flags' = CALCULATE(COUNTROWS(fact_flags), fact_flags[is_visible] = FALSE())
		formatString: #,0
		displayFolder: 1 Leakage

	measure 'Over-billing' = CALCULATE(-SUM(fact_flags[impact_usd]), fact_flags[direction] = "Over-billed", fact_flags[is_visible] = TRUE())
		formatString: $#,0
		displayFolder: 1 Leakage

	measure 'L1 Leakage' = CALCULATE([Total Leakage], fact_flags[rule_id] = "L1")
		formatString: $#,0
		displayFolder: 2 Root causes

	measure 'L2 Leakage' = CALCULATE([Total Leakage], fact_flags[rule_id] = "L2")
		formatString: $#,0
		displayFolder: 2 Root causes

	measure 'Leakage Prev Month' = CALCULATE([Total Leakage], DATEADD(dim_date[date_key], -1, MONTH))
		formatString: $#,0
		displayFolder: 2 Root causes

	measure 'Leakage MoM Change' = [Total Leakage] - [Leakage Prev Month]
		formatString: $#,0
		displayFolder: 2 Root causes

	measure 'Leakage MoM %' = DIVIDE([Leakage MoM Change], [Leakage Prev Month])
		formatString: 0.0%
		displayFolder: 2 Root causes

	measure 'Tax Under-charged' = CALCULATE(SUM(fact_flags[impact_usd]), fact_flags[rule_id] = "L5", fact_flags[tax_direction] = "Under-charged", fact_flags[is_visible] = TRUE())
		formatString: $#,0
		displayFolder: 3 Tax

	measure 'Tax Over-charged' = CALCULATE(-SUM(fact_flags[impact_usd]), fact_flags[rule_id] = "L5", fact_flags[tax_direction] = "Over-charged", fact_flags[is_visible] = TRUE())
		formatString: $#,0
		displayFolder: 3 Tax

	measure 'L5 Flags' = CALCULATE(COUNTROWS(fact_flags), fact_flags[rule_id] = "L5", fact_flags[is_visible] = TRUE())
		formatString: #,0
		displayFolder: 3 Tax

	measure 'Priority Score' = SUM(fact_flags[priority_score])
		formatString: #,0
		displayFolder: 4 Flag review

	measure 'Avg Confidence' = AVERAGE(fact_flags[confidence])
		formatString: 0.00
		displayFolder: 4 Flag review

	measure 'Expected Amount' = SUM(fact_flags[expected_amount])
		formatString: $#,0.00
		displayFolder: 4 Flag review

	measure 'Billed Amount' = SUM(fact_flags[billed_amount])
		formatString: $#,0.00
		displayFolder: 4 Flag review

	measure 'Flag Impact' = SUM(fact_flags[impact_usd])
		formatString: $#,0.00
		displayFolder: 4 Flag review

	measure 'Evidence' = IF(HASONEVALUE(fact_flags[flag_id]), SELECTEDVALUE(fact_flags[evidence_clause]), "Click one flag in the table to see the contract clause it relied on.")
		displayFolder: 4 Flag review

	measure 'Rule Detail' = IF(HASONEVALUE(fact_flags[flag_id]), SELECTEDVALUE(fact_flags[rule_detail]), "")
		displayFolder: 4 Flag review

	measure 'Invoice Match Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_invoice_lines), fact_invoice_lines[match_status] = "Matched"), COUNTROWS(fact_invoice_lines))
		formatString: 0.0%
		displayFolder: 5 Quality

	measure 'Unmatched Revenue' = CALCULATE([Total Revenue], fact_invoice_lines[match_status] = "Unmatched")
		formatString: $#,0
		displayFolder: 5 Quality

	measure 'Recall' = DIVIDE(CALCULATE(COUNTROWS(eval_results), eval_results[outcome] = "TP", eval_results[direction] = "Under-billed"), CALCULATE(COUNTROWS(eval_results), eval_results[outcome] IN {"TP", "FN"}, eval_results[direction] = "Under-billed"))
		formatString: 0.0%
		displayFolder: 5 Quality

	measure 'Precision' = DIVIDE(CALCULATE(COUNTROWS(eval_results), eval_results[outcome] = "TP", eval_results[direction] = "Under-billed"), CALCULATE(COUNTROWS(eval_results), eval_results[outcome] IN {"TP", "FP"}, eval_results[direction] = "Under-billed"))
		formatString: 0.0%
		displayFolder: 5 Quality

	measure 'USD Captured %' = DIVIDE(CALCULATE(SUM(eval_results[planted_usd]), eval_results[outcome] = "TP", eval_results[direction] = "Under-billed"), CALCULATE(SUM(eval_results[planted_usd]), eval_results[outcome] IN {"TP", "FN"}, eval_results[direction] = "Under-billed"))
		formatString: 0.0%
		displayFolder: 5 Quality

	measure 'Review Precision' = DIVIDE(CALCULATE(COUNTROWS(fact_flags), fact_flags[status] = "Confirmed"), CALCULATE(COUNTROWS(fact_flags), fact_flags[status] IN {"Confirmed", "False alarm"}))
		formatString: 0.0%
		displayFolder: 5 Quality

	column flag_id
		dataType: string
		summarizeBy: none
		sourceColumn: flag_id

	column invoice_line_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_line_id

	column invoice_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_id

	column date_key
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_key

	column customer_key
		dataType: string
		summarizeBy: none
		sourceColumn: customer_key

	column contract_id
		dataType: string
		summarizeBy: none
		sourceColumn: contract_id

	column invoice_customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_customer_name

	column product_code
		dataType: string
		summarizeBy: none
		sourceColumn: product_code

	column rule_id
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	column direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	column tax_direction
		dataType: string
		summarizeBy: none
		sourceColumn: tax_direction

	column expected_amount
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: expected_amount

	column billed_amount
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: billed_amount

	column impact_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: impact_usd

	column confidence
		dataType: double
		summarizeBy: none
		sourceColumn: confidence

	column priority_score
		dataType: double
		summarizeBy: none
		sourceColumn: priority_score

	column is_visible
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_visible

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column reviewed_by
		dataType: string
		summarizeBy: none
		sourceColumn: reviewed_by

	column note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	column evidence_clause
		dataType: string
		summarizeBy: none
		sourceColumn: evidence_clause

	column rule_detail
		dataType: string
		summarizeBy: none
		sourceColumn: rule_detail

	partition fact_flags = m
		mode: import
		source = let Source = Csv.Document(File.Contents(DataFolder & "fact_flags.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"flag_id", type text}, {"invoice_line_id", type text}, {"invoice_id", type text}, {"date_key", type date}, {"customer_key", type text}, {"contract_id", type text}, {"invoice_customer_name", type text}, {"product_code", type text}, {"rule_id", type text}, {"direction", type text}, {"tax_direction", type text}, {"expected_amount", type number}, {"billed_amount", type number}, {"impact_usd", type number}, {"confidence", type number}, {"priority_score", type number}, {"is_visible", type logical}, {"status", type text}, {"reviewed_by", type text}, {"note", type text}, {"evidence_clause", type text}, {"rule_detail", type text}}, "en-US") in Typed
