table dim_contract

	column contract_id
		dataType: string
		summarizeBy: none
		sourceColumn: contract_id

	column customer_key
		dataType: string
		summarizeBy: none
		sourceColumn: customer_key

	column customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: customer_name

	column country_code
		dataType: string
		summarizeBy: none
		sourceColumn: country_code

	column start_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: start_date

	column end_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: end_date

	column escalation_pct
		dataType: double
		summarizeBy: none
		sourceColumn: escalation_pct

	column escalation_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: escalation_date

	column products
		dataType: string
		summarizeBy: none
		sourceColumn: products

	column product_count
		dataType: int64
		summarizeBy: none
		sourceColumn: product_count

	column has_discount
		dataType: boolean
		summarizeBy: none
		sourceColumn: has_discount

	column has_usage_tier
		dataType: boolean
		summarizeBy: none
		sourceColumn: has_usage_tier

	column escalation_wording
		dataType: string
		summarizeBy: none
		sourceColumn: escalation_wording

	column discount_wording
		dataType: string
		summarizeBy: none
		sourceColumn: discount_wording

	column min_extraction_confidence
		dataType: double
		summarizeBy: none
		sourceColumn: min_extraction_confidence

	column extractor
		dataType: string
		summarizeBy: none
		sourceColumn: extractor

	column source_file
		dataType: string
		summarizeBy: none
		sourceColumn: source_file

	partition dim_contract = m
		mode: import
		source = let Source = Csv.Document(File.Contents(DataFolder & "dim_contract.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"contract_id", type text}, {"customer_key", type text}, {"customer_name", type text}, {"country_code", type text}, {"start_date", type date}, {"end_date", type date}, {"escalation_pct", type number}, {"escalation_date", type date}, {"products", type text}, {"product_count", Int64.Type}, {"has_discount", type logical}, {"has_usage_tier", type logical}, {"escalation_wording", type text}, {"discount_wording", type text}, {"min_extraction_confidence", type number}, {"extractor", type text}, {"source_file", type text}}, "en-US") in Typed
