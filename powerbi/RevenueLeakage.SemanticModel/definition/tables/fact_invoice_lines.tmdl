table fact_invoice_lines

	column invoice_line_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_line_id

	column invoice_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_id

	column date_key
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_key

	column customer_key
		dataType: string
		summarizeBy: none
		sourceColumn: customer_key

	column contract_id
		dataType: string
		summarizeBy: none
		sourceColumn: contract_id

	column invoice_customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_customer_name

	column product_code
		dataType: string
		summarizeBy: none
		sourceColumn: product_code

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: quantity

	column unit_price
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: unit_price

	column discount_amount
		dataType: double
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: discount_amount

	column net_amount
		dataType: double
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: net_amount

	column tax_rate
		dataType: double
		summarizeBy: none
		sourceColumn: tax_rate

	column tax_amount
		dataType: double
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: tax_amount

	column match_status
		dataType: string
		summarizeBy: none
		sourceColumn: match_status

	column match_method
		dataType: string
		summarizeBy: none
		sourceColumn: match_method

	column match_score
		dataType: double
		summarizeBy: none
		sourceColumn: match_score

	column unmatched_reason
		dataType: string
		summarizeBy: none
		sourceColumn: unmatched_reason

	column flag_count
		dataType: int64
		summarizeBy: none
		sourceColumn: flag_count

	partition fact_invoice_lines = m
		mode: import
		source = let Source = Csv.Document(File.Contents(DataFolder & "fact_invoice_lines.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"invoice_line_id", type text}, {"invoice_id", type text}, {"date_key", type date}, {"customer_key", type text}, {"contract_id", type text}, {"invoice_customer_name", type text}, {"product_code", type text}, {"description", type text}, {"quantity", Int64.Type}, {"unit_price", type number}, {"discount_amount", type number}, {"net_amount", type number}, {"tax_rate", type number}, {"tax_amount", type number}, {"match_status", type text}, {"match_method", type text}, {"match_score", type number}, {"unmatched_reason", type text}, {"flag_count", Int64.Type}}, "en-US") in Typed
