table eval_results

	column invoice_line_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_line_id

	column rule_id
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	column direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	column outcome
		dataType: string
		summarizeBy: none
		sourceColumn: outcome

	column planted_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: planted_usd

	column flagged_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: flagged_usd

	partition eval_results = m
		mode: import
		source = let Source = Csv.Document(File.Contents(DataFolder & "eval_results.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted, {{"invoice_line_id", type text}, {"rule_id", type text}, {"direction", type text}, {"outcome", type text}, {"planted_usd", type number}, {"flagged_usd", type number}}, "en-US") in Typed
